#!/usr/bin/env ruby
# frozen_string_literal: true

# Run with: bundle exec ruby bin/demo-random-icons
# Pass a local random-icons repository path to preview its actual icons.
# Open http://127.0.0.1:9394/?library=random-icons
# Demo fixtures are temporary and never added to the real icon pack.
require "bundler/setup"
require "tmpdir"
require "fileutils"
require "rackup"
require_relative "../lib/unmagic/icon"
require_relative "../lib/unmagic/icon/web"

Dir.mktmpdir("random-icons-demo") do |root|
  pack = File.join(root, "random-icons")
  FileUtils.mkdir_p(pack)
  if ARGV.first
    FileUtils.cp(Dir.glob(File.join(File.expand_path(ARGV.first), "icons", "*.svg")), pack)
    abort "No SVGs found in #{ARGV.first}/icons" if Dir.glob(File.join(pack, "*.svg")).empty?
  else
    File.write(File.join(pack, "demo-colors.svg"), <<~SVG)
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <rect width="12" height="24" fill="#ef4444"/>
        <rect x="12" width="12" height="24" fill="#22c55e"/>
      </svg>
    SVG
  end
  Unmagic::Icon.init { |config| config.paths = [root] }
  puts "Icon preview: http://127.0.0.1:9394/?library=random-icons"
  Rackup::Handler.get("puma").run(Unmagic::Icon::Web.new, Host: "127.0.0.1", Port: 9394)
end
